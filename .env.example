# Copy to .env for local development without Docker. Never commit real values.
# In production, inject these from your platform's secret manager.
# Generate secrets with: openssl rand -hex 32

# ---------- shared ----------
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
AUDIT_IP_HMAC_KEY=CHANGE_ME_TO_32_PLUS_RANDOM_CHARS
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_MEDIA=tc-media
S3_BUCKET_QUARANTINE=tc-quarantine

# ---------- API (connects as tc_api_login: never the owner or a superuser) ----------
DATABASE_URL=postgres://tc_api_login:CHANGE_ME@localhost:5432/timecapsule
DATABASE_POOL_MAX=10
# 300–900 seconds.
PLAYBACK_URL_TTL_SECONDS=600
# Auth.js cookie: authjs.session-token over http, __Secure-authjs.session-token over https.
SESSION_COOKIE_NAME=authjs.session-token
METRICS_TOKEN=CHANGE_ME_TO_32_PLUS_RANDOM_CHARS
# SENTRY_DSN=

# ---------- worker (connects as tc_worker_login) ----------
# DATABASE_URL=postgres://tc_worker_login:CHANGE_ME@localhost:5432/timecapsule
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORK_DIR=/tmp/tc-work
# Unset = in-app notifications only.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=TimeCapsule.fm <no-reply@timecapsule.fm>

# ---------- migrations / seed / agreements (schema owner) ----------
DATABASE_MIGRATOR_URL=postgres://tc_migrator:CHANGE_ME@localhost:5432/timecapsule
CORS_ORIGIN=http://localhost:3000

# ---------- web ----------
API_INTERNAL_URL=http://localhost:4000
# `next dev` only: proxy /api/* to the API.
API_DEV_PROXY_URL=http://localhost:4000
# Auth.js (connects as tc_auth_login).
DATABASE_AUTH_URL=postgres://tc_auth_login:CHANGE_ME@localhost:5432/timecapsule
AUTH_SECRET=CHANGE_ME_TO_32_PLUS_RANDOM_CHARS
AUTH_TRUST_HOST=true
# Optional OAuth providers; each appears on the sign-in page only when set.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
MEDIA_ORIGINS=http://localhost:8333
# Production: your self-hosted PMTiles style. Unset in dev = OpenFreeMap.
# MAP_STYLE_URL=https://maps.timecapsule.fm/style.json
# MAP_ORIGINS=https://maps.timecapsule.fm
TAKEDOWN_EMAIL=legal@example.com
