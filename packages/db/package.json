{
  "name": "@timecapsule/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test seed",
    "test": "vitest run",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx seed/seed.ts",
    "storage:init": "tsx src/cli/storage-init.ts",
    "agreement:publish": "tsx src/cli/publish-agreement.ts",
    "demo:export": "tsx seed/export-demo.ts"
  },
  "dependencies": {
    "@timecapsule/shared": "workspace:*",
    "kysely": "0.29.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-postgis": "0.2.10",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
